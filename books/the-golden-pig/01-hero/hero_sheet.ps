%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, hero sheet: the people
/Seed where { pop } { /Seed 2 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-mh-ground
/cb-ch-face 1 def
% the mother: standing, and holding the baby
/cb-ch-hair /bun def /cb-ch-cloth /skirt def /cb-ch-pose /stand def /cb-ch-trim cb-mh-red def
/cb-ch-top [0.96 0.95 0.90] def /cb-ch-age /adult def
40 330 200 cb-mh-jade cb-ch-person pop pop
/cb-ch-pose /hold def
/cb-ch-held { exch 28 sub exch 4 sub 58 cb-ch-baby } def
150 330 200 cb-mh-jade cb-ch-person pop pop
/cb-ch-held { pop pop } def
% the magistrate
/cb-ch-lean 6 def
280 330 210 [0.92 0.92 0.86] cb-ch-magistrate pop pop
/cb-ch-lean 0 def
% the boy: three (writing), ten, twelve
/cb-ch-cloth /robe def /cb-ch-hair /braid def /cb-ch-trim cb-mh-blue def /cb-ch-saekdong true def
/cb-ch-age /tot def /cb-ch-pose /kneel def
385 330 100 cb-mh-green cb-ch-person pop pop
/cb-ch-age /youth def /cb-ch-pose /stand def
455 330 150 cb-mh-green cb-ch-person pop pop
/cb-ch-pose /walk def /cb-ch-lean 4 def
525 330 172 cb-mh-green cb-ch-person pop pop
/cb-ch-lean 0 def /cb-ch-saekdong false def
% Chiwon grown, a scholar in Tang
/cb-ch-age /adult def /cb-ch-hair /putou def /cb-ch-pose /stand def /cb-ch-trim cb-mh-red def
100 40 225 cb-mh-blue cb-ch-person pop pop
% Unyeong
/cb-ch-hair /bun def /cb-ch-cloth /skirt def /cb-ch-top cb-mh-yellow def /cb-ch-trim cb-mh-red def
/cb-ch-face -1 def
250 40 195 cb-mh-pink cb-ch-person pop pop
% the boy at the smallest scale the book needs
/cb-ch-face 1 def /cb-ch-hair /braid def /cb-ch-age /youth def /cb-ch-cloth /robe def /cb-ch-trim cb-mh-blue def /cb-ch-saekdong true def
330 40 45 cb-mh-green cb-ch-person pop pop
/cb-ch-saekdong false def
% the baby alone
400 70 90 cb-ch-baby
cb-ink cb-rgb /cb-size 12 def
(mother) 40 590 200 /left cb-text pop
(Choe Chung) 290 590 200 /left cb-text pop
(the boy: 3, 10, 12) 400 590 200 /left cb-text pop
