%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, style study A: small figures in a big patterned landscape
/Seed where { pop } { /Seed 5 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-mh-ground
(books/the-golden-pig/01-style/scene.inc) run
/moonx 130 def /moony 430 def /moonr 30 def
{
  cb-st-back cb-st-night
  /cb-ch-mode /flat def /cb-ch-face 1 def /cb-ch-lean 8 def
  320 212 50 [0.92 0.92 0.86] cb-ch-magistrate /hy exch def /hx exch def
  [ 30 196  150 210  250 206  hx hy  380 236  440 250  492 262 ] cb-gp-thread
} cb-gp-panel
cb-st-ko cb-st-en cb-gp-texts
showpage
