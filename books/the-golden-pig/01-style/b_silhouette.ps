%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, style study B: a silhouette against the moon
/Seed where { pop } { /Seed 5 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-mh-ground
(books/the-golden-pig/01-style/scene.inc) run
/moonx 250 def /moony 330 def /moonr 78 def
{
  cb-st-back cb-st-night
  /cb-ch-mode /silhouette def /cb-ch-face 1 def /cb-ch-lean 8 def
  225 206 150 [0.92 0.92 0.86] cb-ch-magistrate /hy exch def /hx exch def
  [ 30 196  140 210  hx 25 sub hy 20 sub  hx hy  360 252  430 258  470 260  492 262 ] cb-gp-thread
} cb-gp-panel
cb-st-ko cb-st-en cb-gp-texts
showpage
