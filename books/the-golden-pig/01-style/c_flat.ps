(books/the-golden-pig/01-style/scene.inc) run
/moonx 130 def /moony 430 def /moonr 30 def
{
  cb-st-back cb-st-night
  /cb-ch-mode /flat def /cb-ch-face 1 def /cb-ch-lean 8 def
  175 202 190 [0.92 0.92 0.86] cb-ch-magistrate /hy exch def /hx exch def
  [ 30 196  100 205  hx 30 sub hy 25 sub  hx hy  330 250  420 256  470 260  492 262 ] cb-gp-thread
} cb-gp-panel
cb-st-ko cb-st-en cb-gp-texts
showpage
