%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, style study C: a flat minhwa figure, close
/Seed where { pop } { /Seed 5 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-mh-ground
(books/the-golden-pig/01-style/scene.inc) run
/moonx 130 def /moony 430 def /moonr 30 def
{
  cb-st-back cb-st-night
  /cb-ch-mode /flat def /cb-ch-face 1 def
  190 150 200 cb-mh-jade cb-ch-magistrate /hy exch def /hx exch def
  [ 40 140  110 160  hx 25 sub hy 15 sub  hx hy  330 240  420 246  470 252  492 262 ] cb-gp-thread
} cb-gp-panel
cb-st-ko cb-st-en cb-gp-texts
showpage
