%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, storyboard p. 15
/Seed where { pop } { /Seed 15 def } ifelse  Seed srand
(lib/cb_book.ps) run
(books/the-golden-pig/text.ps) run
cb-mh-ground
% M, court. The King of Silla and two wise men shaking the box.
{
  210 cb-gp-room
  newpath 30 210 552 40 cb-mh-rect [0.70 0.30 0.24] 0.5 cb-mh-flat
  /cb-ch-age /adult def /cb-ch-cloth /robe def /cb-ch-pose /stand def
  /cb-ch-face 1 def /cb-ch-hair /crown def /cb-ch-beard true def
  100 190 240 cb-mh-red cb-ch-person pop pop
  /cb-ch-hair /putou def /cb-ch-face -1 def /cb-ch-pose /hold def /cb-ch-held { pop pop } def
  /cb-ch-old true def
  400 190 210 [0.44 0.50 0.60] cb-ch-person pop pop
  /cb-ch-old false def /cb-ch-pose /stand def
  520 190 210 [0.50 0.44 0.36] cb-ch-person pop pop
  /cb-ch-beard false def
  280 240 70 false cb-gp-box
  % question marks of puzzlement, as ink
  /NewCenturySchlbk-Roman 30 cb-type cb-ink cb-rgb 470 420 moveto (?) show 540 410 moveto (?) show
} cb-gp-panel
15 cb-gp-say
showpage
