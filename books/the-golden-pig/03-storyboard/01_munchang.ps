%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, storyboard p. 1
/Seed where { pop } { /Seed 1 def } ifelse  Seed srand
(lib/cb_book.ps) run
(books/the-golden-pig/text.ps) run
cb-mh-ground
% W, night. The town asleep under the great crag; one lit window; closed
% sunflowers by the gate.
{
  /night cb-gp-sky
  130 420 26 cb-gp-moon
  470 200 260 300 [0.40 0.46 0.66] [0.24 0.28 0.48] 5 cb-mh-crag
  180 220 160 150 [0.36 0.44 0.62] [0.22 0.28 0.46] 3 cb-mh-crag
  205 [0.24 0.34 0.32] cb-gp-land
  110 178 110 70 [0.20 0.22 0.28] cb-mh-hall
  290 182 200 120 [0.20 0.22 0.28] cb-mh-hall
  % the one lit window
  newpath 294 197 16 30 cb-mh-rect [1.0 0.80 0.40] 0.9 cb-mh-flat
  440 176 100 64 [0.20 0.22 0.28] cb-mh-hall
  /cb-mh-sfopen 0 def
  50 150 60 4 -10 cb-mh-sunflowerplant
  72 150 46 -4 0 cb-mh-sunflowerplant
} cb-gp-panel
1 cb-gp-say
showpage
