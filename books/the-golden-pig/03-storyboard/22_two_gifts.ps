%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, storyboard p. 22
/Seed where { pop } { /Seed 22 def } ifelse  Seed srand
(lib/cb_book.ps) run
(books/the-golden-pig/text.ps) run
cb-mh-ground
% M, day. Two gifts: the old woman with the soy-soaked cotton on the road
% (left); the woman by the river with three charms (right).
{
  /day cb-gp-sky
  newpath 306 150 moveto 306 462 lineto 1.2 cb-line
  210 [0.74 0.70 0.52] cb-gp-land
  newpath 320 150 270 60 cb-mh-rect [0.40 0.60 0.74] 0.9 cb-mh-flat
  /cb-ch-cloth /robe def /cb-ch-hair /braid def /cb-ch-saekdong true def /cb-ch-trim cb-mh-blue def /cb-ch-age /youth def /cb-ch-pose /hold def /cb-ch-face 1 def /cb-ch-held { pop pop } def
  70 196 150 cb-mh-green cb-ch-person pop pop
  360 200 150 cb-mh-green cb-ch-person pop pop
  /cb-ch-saekdong false def /cb-ch-age /adult def /cb-ch-pose /hold def
  /cb-ch-cloth /skirt def /cb-ch-hair /bun def /cb-ch-face -1 def /cb-ch-old true def /cb-ch-top [0.86 0.84 0.78] def
  220 196 170 [0.62 0.56 0.50] cb-ch-person pop pop
  /cb-ch-old false def /cb-ch-top cb-mh-white def
  510 200 190 cb-mh-jade cb-ch-person pop pop
  /cb-ch-pose /stand def
  % the cotton and the charms between the hands
  newpath 150 280 10 0 360 arc closepath [0.94 0.90 0.80] 0.95 cb-mh-flat 0.7 cb-line
  0 1 2 { /k exch def newpath 432 k 12 mul add 290 9 14 cb-mh-rect [0.96 0.86 0.40] 0.95 cb-mh-flat 0.6 cb-line } for
  /cb-mh-sfopen 1 def
  270 150 90 -4 20 cb-mh-sunflowerplant 570 150 90 -4 20 cb-mh-sunflowerplant
} cb-gp-panel
22 cb-gp-say
showpage
