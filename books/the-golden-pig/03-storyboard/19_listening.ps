%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, storyboard p. 19
/Seed where { pop } { /Seed 19 def } ifelse  Seed srand
(lib/cb_book.ps) run
(books/the-golden-pig/text.ps) run
cb-mh-ground
% C, lamplight. The boy, the box at his ear, the brush ready.
{
  200 cb-gp-room
  newpath -20 200 652 300 cb-mh-rect [0.20 0.16 0.24] 0.5 cb-mh-flat
  470 230 90 cb-gp-lamp
  /cb-ch-cloth /robe def /cb-ch-hair /braid def /cb-ch-saekdong true def /cb-ch-trim cb-mh-blue def /cb-ch-age /youth def /cb-ch-pose /kneel def /cb-ch-face 1 def
  200 180 260 cb-mh-green cb-ch-person pop pop
  /cb-ch-saekdong false def /cb-ch-age /adult def
  % the box held up at his ear
  262 330 60 false cb-gp-box
  % paper and brush on the floor
  newpath 320 186 110 20 cb-mh-rect cb-mh-white 0.95 cb-mh-flat 0.8 cb-line
  newpath 330 210 moveto 400 196 lineto [0.40 0.26 0.16] cb-rgb << /Width 3 /Taper 0.3 >> pkliner
  /cb-mh-sfopen 1 def
  560 150 110 -6 -40 cb-mh-sunflowerplant
} cb-gp-panel
19 cb-gp-say
showpage
