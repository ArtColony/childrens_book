cb-mh-ground
% W, dawn. The rock split open; the wives walk out to Choe Chung; the
% fallen pig in the gold inside.
{
  /dawn cb-gp-sky
  110 300 210 150 [0.56 0.62 0.78] [0.40 0.44 0.64] 5 cb-mh-crag
  % the rock, split: two crags with a gold gap between
  380 150 170 320 [0.66 0.60 0.70] [0.42 0.36 0.50] 3 cb-mh-crag
  newpath 462 160 moveto 470 330 lineto 486 330 lineto 498 160 lineto closepath cb-mh-gold 0.8 cb-mh-flat
  560 150 150 300 [0.66 0.60 0.70] [0.42 0.36 0.50] 3 cb-mh-crag
  200 [0.50 0.58 0.42] cb-gp-land
  /cb-gp-face -1 def /cb-gp-mood /dead def
  500 168 60 cb-gp-pig pop pop
  /cb-ch-hair /bun def /cb-ch-cloth /skirt def /cb-ch-pose /walk def /cb-ch-face -1 def
  /cb-ch-top cb-mh-white def
  330 190 160 cb-mh-jade cb-ch-person pop pop
  /cb-ch-top [0.86 0.86 0.80] def
  400 196 120 [0.50 0.56 0.60] cb-ch-person pop pop
  440 200 100 [0.56 0.50 0.58] cb-ch-person pop pop
  /cb-ch-face 1 def /cb-ch-pose /stand def
  150 186 190 [0.92 0.92 0.86] cb-ch-magistrate pop pop
  /cb-mh-sfopen 0.6 def
  60 150 70 6 -10 cb-mh-sunflowerplant
} cb-gp-panel
