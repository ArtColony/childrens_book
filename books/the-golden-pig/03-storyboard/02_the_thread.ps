%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, storyboard p. 2
/Seed where { pop } { /Seed 2 def } ifelse  Seed srand
(lib/cb_book.ps) run
(books/the-golden-pig/text.ps) run
cb-mh-ground
% C, lamplight. He ties the red thread on her wrist. Her pouch hangs on a
% spotted deerskin cord. Sunflowers closed in a vase.
{
  200 cb-gp-room
  470 300 60 cb-gp-lamp
  % a vase of closed sunflowers
  newpath 520 200 moveto 512 230 lineto 548 230 lineto 540 200 lineto closepath [0.42 0.58 0.66] 0.95 cb-mh-flat 1 cb-line
  /cb-mh-sfopen 0.1 def
  530 228 80 -8 0 cb-mh-sunflowerplant
  % the wife, kneeling, facing him; the magistrate kneeling, tying
  /cb-ch-face -1 def /cb-ch-hair /bun def /cb-ch-cloth /skirt def /cb-ch-pose /kneel def
  /cb-ch-top cb-mh-white def /cb-ch-trim cb-mh-red def /cb-ch-age /adult def
  360 170 270 cb-mh-jade cb-ch-person /wy exch def /wx exch def
  % the pouch on its deerskin cord, at her waist
  newpath 372 262 moveto 380 236 lineto [0.62 0.40 0.22] cb-rgb << /Width 3 /Taper 0 >> pkliner
  newpath 380 228 10 0 360 arc closepath [0.80 0.30 0.30] 0.95 cb-mh-flat 0.8 cb-line
  /cb-ch-face 1 def /cb-ch-hair /putou def /cb-ch-cloth /robe def /cb-ch-beard true def
  170 170 280 [0.92 0.92 0.86] cb-ch-person /hy exch def /hx exch def
  /cb-ch-beard false def
  [ hx hy hx 20 add hy 6 add wx wy ] cb-gp-thread
} cb-gp-panel
2 cb-gp-say
showpage
