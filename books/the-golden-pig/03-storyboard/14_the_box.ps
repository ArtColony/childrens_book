%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, storyboard p. 14
/Seed where { pop } { /Seed 14 def } ifelse  Seed srand
(lib/cb_book.ps) run
(books/the-golden-pig/text.ps) run
cb-mh-ground
% M, court. The Emperor sealing the stone box; a comic tiger on the screen.
{
  210 cb-gp-room
  % the screen behind, with its tiger
  newpath 300 210 240 230 cb-mh-rect [0.94 0.90 0.80] 0.95 cb-mh-flat 1.4 cb-line
  newpath 380 210 moveto 380 440 lineto 460 210 moveto 460 440 lineto 0.8 cb-line
  /cb-mh-face -1 def 420 240 160 cb-mh-tiger
  /cb-ch-face 1 def /cb-ch-hair /mian def /cb-ch-cloth /robe def /cb-ch-pose /stand def /cb-ch-beard true def
  /cb-ch-age /adult def
  180 180 250 cb-mh-yellow cb-ch-person pop pop
  /cb-ch-beard false def
  newpath 230 180 160 70 cb-mh-rect [0.50 0.24 0.16] 0.95 cb-mh-flat 1 cb-line
  300 250 90 false cb-gp-box
} cb-gp-panel
14 cb-gp-say
showpage
