%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, storyboard p. 8
/Seed where { pop } { /Seed 8 def } ifelse  Seed srand
(lib/cb_book.ps) run
(books/the-golden-pig/text.ps) run
cb-mh-ground
% W, grey. The baby small on the sand; the father walking away; the
% mother far off at the town gate.
{
  /grey cb-gp-sky
  250 [0.46 0.54 0.62] cb-gp-sea
  205 [0.86 0.80 0.66] cb-gp-land
  540 260 80 50 [0.30 0.30 0.34] cb-mh-hall
  /cb-ch-cloth /skirt def /cb-ch-hair /bun def /cb-ch-face -1 def /cb-ch-pose /stand def /cb-ch-top cb-mh-white def
  500 258 34 cb-mh-jade cb-ch-person pop pop
  /cb-ch-face 1 def /cb-ch-lean 6 def
  360 200 110 [0.92 0.92 0.86] cb-ch-magistrate pop pop
  /cb-ch-lean 0 def
  /cb-ch-face 1 def 120 190 46 cb-ch-baby
} cb-gp-panel
8 cb-gp-say
showpage
