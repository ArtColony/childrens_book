%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, storyboard p. 23
/Seed where { pop } { /Seed 23 def } ifelse  Seed srand
(lib/cb_book.ps) run
(books/the-golden-pig/text.ps) run
cb-mh-ground
% M, court. Chiwon pushing the poisoned bowl away; the charm glowing in his
% sleeve; the Emperor watching.
{
  210 cb-gp-room
  newpath 30 210 552 252 cb-mh-rect [0.70 0.30 0.24] 0.35 cb-mh-flat
  newpath 240 210 180 50 cb-mh-rect [0.50 0.24 0.16] 0.95 cb-mh-flat 1 cb-line
  /cb-ch-cloth /robe def /cb-ch-hair /braid def /cb-ch-saekdong true def /cb-ch-trim cb-mh-blue def /cb-ch-age /youth def /cb-ch-pose /kneel def /cb-ch-face 1 def
  170 190 190 cb-mh-green cb-ch-person /hy exch def /hx exch def
  /cb-ch-saekdong false def /cb-ch-age /adult def
  % the bowl, pushed away, a wisp of poison over it
  newpath hx 30 add 260 moveto hx 40 add 244 hx 70 add 244 hx 80 add 260 curveto closepath [0.86 0.84 0.78] 0.95 cb-mh-flat 0.8 cb-line
  newpath hx 50 add 264 moveto hx 40 add 280 hx 60 add 290 hx 52 add 306 curveto [0.40 0.56 0.30] cb-rgb << /Width 2 /Taper 0.5 >> pkliner
  % the warm charm, glowing at his sleeve
  newpath 150 320 22 0 360 arc closepath [1.0 0.80 0.40] 0.35 cb-mh-flat
  newpath 144 312 12 16 cb-mh-rect [0.96 0.86 0.40] 0.95 cb-mh-flat 0.6 cb-line
  /cb-ch-hair /mian def /cb-ch-face -1 def /cb-ch-pose /stand def /cb-ch-beard true def
  480 200 240 cb-mh-yellow cb-ch-person pop pop
  /cb-ch-beard false def
} cb-gp-panel
23 cb-gp-say
showpage
