%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Golden Pig, storyboard p. 12
/Seed where { pop } { /Seed 12 def } ifelse  Seed srand
(lib/cb_book.ps) run
(books/the-golden-pig/text.ps) run
cb-mh-ground
% M, evening. The new pavilion; the father bowing; the boy running past
% him to his mother.
{
  /evening cb-gp-sky
  300 [0.44 0.50 0.66] cb-gp-sea
  230 [0.86 0.78 0.62] cb-gp-land
  300 220 230 150 cb-mh-pavilion
  /cb-ch-face 1 def /cb-ch-lean 22 def /cb-ch-hair /putou def /cb-ch-pose /stand def /cb-ch-beard true def
  130 190 190 [0.92 0.92 0.86] cb-ch-person pop pop
  /cb-ch-lean 0 def /cb-ch-beard false def
  /cb-ch-cloth /robe def /cb-ch-hair /braid def /cb-ch-saekdong true def /cb-ch-trim cb-mh-blue def /cb-ch-age /tot def /cb-ch-pose /walk def /cb-ch-lean 10 def
  300 180 120 cb-mh-green cb-ch-person pop pop
  /cb-ch-lean 0 def /cb-ch-saekdong false def /cb-ch-age /adult def
  /cb-ch-cloth /skirt def /cb-ch-hair /bun def /cb-ch-face -1 def /cb-ch-pose /hold def /cb-ch-top cb-mh-white def
  /cb-ch-held { pop pop } def
  470 180 200 cb-mh-jade cb-ch-person pop pop
  /cb-mh-sfopen 0.7 def
  560 150 110 -6 -20 cb-mh-sunflowerplant
} cb-gp-panel
12 cb-gp-say
showpage
