%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: Ten Boats Home, page 15: ten
/Seed where { pop } { /Seed 115 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-ground
/night cb-light /cb-fogc [0.40 0.44 0.53] def
300 cb-harbour-sky
% the nine, home and moored, far behind
/cb-face -1 def
0 1 8 { /i exch def 300 i 34 mul add 304 9 cb-sails i get cb-boat } for
/cb-face 1 def
300 40 sub 600 0.3 cb-fog
% close and low: Grandpa's little blue boat comes alongside, its lamp answering Ana's
/cb-boatlight true def /cb-face -1 def 430 70 92 cb-gpboat /cb-face 1 def /cb-boatlight false def
-9 270 170 70 cb-pier
/cb-arm /out def /cb-lamp true def /cb-lit true def /cb-glowr 0.8 def /cb-grin true def
200 170 130 cb-ana
/cb-arm /down def /cb-lamp false def /cb-lit false def /cb-glowr 0.8 def /cb-grin false def
/cb-mamahand [0.20 0.40] def 150 170 160 cb-mama /cb-mamahand [0.24 0.55] def
cb-paper cb-rgb
cb-fontit findfont 46 scalefont setfont (Ten!) 306 540 showctr
cb-font findfont cb-size 2 add scalefont setfont (Little. Blue. Grandpa's.) 306 494 showctr
/cb-foliorgb cb-paper def 15 cb-folio
showpage
