%%BoundingBox: 0 0 612 612
%%Title: Ten Boats Home, cover
/Seed where { pop } { /Seed 100 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-ground
/dusk cb-light
230 cb-harbour-sky
-9 470 120 80 cb-pier
/cb-arm /out def /cb-lamp true def /cb-lit true def /cb-glowr 1.0 def
420 120 160 cb-ana
/cb-arm /down def /cb-lamp false def /cb-lit false def /cb-glowr 0.8 def
/cb-mamahand [0.20 0.40] def 360 120 200 cb-mama /cb-mamahand [0.24 0.55] def
cb-paper cb-rgb
cb-titlefont findfont 64 scalefont setfont (Ten Boats) 306 520 showctr (Home) 306 452 showctr
cb-fontit findfont 16 scalefont setfont (a counting book) 306 414 showctr
showpage
