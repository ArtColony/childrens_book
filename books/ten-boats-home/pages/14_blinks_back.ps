/cb-arm /up def /cb-lamp true def /cb-lit true def /cb-glowr 1.6 def
80 200 80 cb-ana
/cb-arm /down def /cb-lamp false def /cb-lit false def /cb-glowr 0.8 def
/cb-boatlight true def /cb-face -1 def 420 150 70 cb-gpboat /cb-face 1 def /cb-boatlight false def
0 600 0.25 cb-fog
