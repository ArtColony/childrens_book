%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: Ten Boats Home, page 13: higher
/Seed where { pop } { /Seed 113 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-ground
/fognight cb-light /cb-fogc [0.40 0.44 0.53] def
220 cb-harbour-sky
-9 520 100 90 cb-pier
0 600 0.6 cb-fog
% closer than p12; on tiptoe, both arms straight up: the biggest light in the book
/cb-arm /top def /cb-lamp true def /cb-lit true def /cb-glowr 1.5 def /cb-tiptoe true def
306 100 200 cb-ana
/cb-arm /down def /cb-lamp false def /cb-lit false def /cb-glowr 0.8 def /cb-tiptoe false def
180 100 250 cb-mama
cb-paper cb-rgb
cb-fontit findfont 34 scalefont setfont (So she holds it higher.) 306 560 showctr
/cb-foliorgb cb-paper def 13 cb-folio
showpage
