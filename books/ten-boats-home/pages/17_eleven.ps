%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: Ten Boats Home, page 17: eleven
/Seed where { pop } { /Seed 117 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-ground
/night cb-light
220 cb-harbour-sky
% the count, laid out so a finger can follow it: ten boats in a row,
% and at the end of the row, held up at the same height, the eleventh thing
/cb-face 1 def
0 1 8 { /i exch def 34 i 42 mul add 262 17 cb-sails i get cb-boat } for
/cb-boatlight true def 34 9 42 mul add 262 13 cb-gpblue cb-boat /cb-boatlight false def
-9 700 60 120 cb-pier
/cb-face -1 def 620 10 330 cb-mama /cb-face 1 def
/cb-gparm /lift def /cb-face -1 def 560 10 330 cb-grandpa /cb-gparm /reach def
/cb-grin true def /cb-arm /up def /cb-lamp true def /cb-lit true def /cb-glowr 0.55 def
560 330 0.24 mul sub 10 330 0.62 mul add 150 0.13 mul sub 150 cb-ana
/cb-grin false def /cb-arm /down def /cb-lamp false def /cb-lit false def /cb-glowr 0.8 def
/cb-face 1 def
cb-paper cb-rgb
cb-fontit findfont 46 scalefont setfont (\252Eleven,\272) 306 540 showctr
cb-font findfont cb-size scalefont setfont (says Ana.) 306 500 showctr
/cb-foliorgb cb-paper def 17 cb-folio
showpage
