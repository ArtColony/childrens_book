%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: Ten Boats Home, page 8: ten is fog
/Seed where { pop } { /Seed 108 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-ground
/fog cb-light
cb-harbour-back 9 cb-moored-n
cb-HZ 80 sub 470 0.40 cb-fog
% the fog stands where the tenth boat should be: low, wide banks of mist that
% thicken toward the empty mooring (flat ellipses, never a ball)
[ [0 10 150 26] [-30 34 120 22] [10 -8 130 18] [-60 18 110 20] [0 56 90 16] ] {
  aload pop /fry exch def /frx exch def /fdy exch def /fdx exch def
  newpath { cb-tenth 0 get fdx add cb-tenth 1 get 20 add fdy add translate frx fry scale 0 0 1 0 360 arc closepath } cb-local
  [0.88 0.88 0.87] 0.16 cb-bigwash
} forall
cb-harbour-front false cb-hook-lamp
40 cb-DECK cb-RAIL add 70 52 cb-nets
30 cb-DECK 150 cb-mama
170 cb-DECK 100 cb-ana
cb-ink cb-rgb
(But ten is not a boat.) 56 584 500 /center cb-text pop
cb-fontit findfont 40 scalefont setfont (Ten is fog.) 306 500 showctr
8 cb-folio
showpage
