%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: Puff, hero sheet
% Stage 1 gate: Puff must show her feelings with no arms or legs. Every mood
% the story needs, at the size the pages use, on the sky she is seen against.
/Seed where { pop } { /Seed 1 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-ground
0 cb-sky cb-skylite cb-sky-wash
/lab { cb-ink cb-rgb cb-font findfont 11 scalefont setfont showctr } def
% row 1: Puff's moods at 90 pt (a mid shot)
/row1 [ /calm /hope /sad /wow ] def
0 1 3 { /i exch def /cb-mood row1 i get def 90 i 140 mul add 520 90 cb-puff
  row1 i get 20 string cvs 90 i 140 mul add 470 lab } for
/row2 [ /push /thin /joy ] def
0 1 2 { /i exch def /cb-mood row2 i get def
  row2 i get /thin eq { /cb-wisp 0.55 def } if
  90 i 140 mul add 395 90 cb-puff /cb-wisp 0 def
  row2 i get 20 string cvs 90 i 140 mul add 345 lab } for
/cb-mood /calm def
% looking down-left, and tiny (wide shot)
/cb-lookx -1 def /cb-looky -1 def 510 395 90 cb-puff /cb-lookx 0 def /cb-looky 0 def
(looking down) 510 345 lab
% row 3: a big cloud, grand and rumbling, with Puff beside it for scale
/cb-cloudc cb-bigc def /cb-cheek false def
/cb-mood /grand def 150 240 300 cb-puff
/cb-mood /rumble def 470 240 260 cb-puff
/cb-cloudc cb-paper def /cb-cheek true def /cb-mood /hope def
305 205 44 cb-puff
(big clouds: grand / rumble, Puff at 44 pt) 306 150 lab
% row 4: the field: seedling wilted, perking, standing; the sunflower
[150 130 110 100 90 100] cb-straw 0.6 cb-hill
/cb-droop 1 def 70 70 46 cb-sprout
/cb-droop 0.5 def 150 70 46 cb-sprout
/cb-droop 0 def 230 70 46 cb-sprout
/cb-droop 0 def
/cb-flmood /joy def 400 40 110 cb-sunflower /cb-flmood /calm def
70 40 9 cb-drop 90 52 9 cb-drop
showpage
