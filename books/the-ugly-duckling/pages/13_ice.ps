%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Ugly Duckling, page 13: the ice (no words)
/Seed where { pop } { /Seed 23 def } ifelse  Seed srand
(lib/cb_book.ps) run
/cb-font /Palatino-Roman def /cb-fontit /Palatino-Italic def /cb-size 21 def
cb-ground
/winter cb-season
640 306 300 92 cb-pice
newpath -9 -9 630 630 cb-rect [0.16 0.20 0.36] 0.35 cb-bigwash
/cb-dkgrow 0.75 def 306 290 92 cb-duckling /cb-dkgrow 0 def
-9 640 70 9 cb-psnow
/cb-foliorgb cb-paper def
13 cb-folio
showpage
