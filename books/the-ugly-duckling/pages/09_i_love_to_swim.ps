%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Ugly Duckling, page 9: I love to swim
/Seed where { pop } { /Seed 19 def } ifelse  Seed srand
(lib/cb_book.ps) run
/cb-font /Palatino-Roman def /cb-fontit /Palatino-Italic def /cb-size 21 def /cb-grain 0 def   % paint covers the paper everywhere
cb-ground
/summer cb-season
200 cb-psky
200 cb-pwater 420 200 90 cb-pglints
newpath 420 214 26 0 360 arc closepath [0.99 0.90 0.60] cb-bfill
-10 620 204 cb-pmist
newpath -9 -9 129 630 cb-rect [0.86 0.74 0.56] cb-bfill            % the cottage wall inside, lamp-lit
newpath -9 -9 129 630 cb-rect [0.70 0.56 0.40] 0.4 cb-bigwash
newpath 120 -9 moveto 120 640 lineto 150 640 lineto 150 -9 lineto closepath [0.36 0.26 0.20] cb-bfill   % the frame
newpath 120 40 moveto 40 0 lineto 40 520 lineto 120 470 lineto closepath [0.50 0.34 0.24] cb-bfill     % the open door
newpath 108 250 5 0 360 arc closepath [0.86 0.72 0.36] cb-bfill                                         % its latch
newpath 150 -9 moveto 150 60 lineto 360 60 lineto 330 -9 lineto closepath [0.80 0.68 0.48] cb-bfill      % the doorstep, in the lamplight
newpath { 262 56 translate 1 0.18 scale 0 0 68 0 360 arc closepath } cb-local [0.56 0.44 0.32] cb-bfill   % his shadow
/cb-dkgrow 0.3 def 260 58 142 cb-duckling /cb-dkgrow 0 def
500 621 220 18 cb-preeds
cb-ink cb-rgb
(\252But I love to swim,\272 said the duckling, \252and to dive to the bottom of the water.\272 \252What nonsense!\272 said the hen. So the duckling went back out into the wide world.) 220 584 360 /left cb-text pop
/cb-foliorgb cb-paper def 9 cb-folio
showpage
