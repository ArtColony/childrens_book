%!PS-Adobe-3.0
%%BoundingBox: 0 0 612 612
%%Title: The Ugly Duckling, style study C: a colour print
/Seed where { pop } { /Seed 3 def } ifelse  Seed srand
(lib/cb_book.ps) run
cb-ground
% five inks, as if from five carved blocks, each block a little off register
/indigo [0.16 0.20 0.36] def  /rust [0.74 0.34 0.20] def  /ochre [0.88 0.68 0.32] def
/rose [0.90 0.62 0.56] def  /slate [0.48 0.56 0.66] def
/reg { 2 jit 2 jit translate } def                  % misregistration per block
/ink { cb-rgb fill } def
/grain { % sprinkle unprinted specks over the last block (ink that didn't take)
  gsave clip -9 -9 630 630 screct << /Count 700 /Seed 7 /Mark { pop pop newpath 0.5 0 360 arc closepath cb-paper cb-rgb fill } >> scatter grestore } def
% sky: flat bands of rose and ochre, the paper left bare for the light
gsave reg newpath -9 400 630 220 cb-rect rose ink grestore
gsave reg newpath -9 330 630 70 cb-rect [0.94 0.76 0.56] ink grestore
gsave reg newpath -9 400 630 220 cb-rect 0.55 setgray newpath -9 470 630 150 cb-rect [0.70 0.52 0.66] ink grestore
gsave reg newpath -9 540 630 80 cb-rect [0.52 0.42 0.62] ink grestore
% sun: a bare-paper disc ringed in ochre
gsave reg newpath 470 236 46 0 360 arc closepath ochre ink grestore
newpath 470 236 34 0 360 arc closepath [0.98 0.90 0.70] ink
% trees: flat lollipops, two inks
[ [40 230 40 rust] [100 236 48 ochre] [166 226 32 rust] [380 232 42 ochre] [452 240 54 rust] [544 230 40 ochre] [596 226 30 rust] ]
{ aload pop /c exch def /r exch def /y exch def /x exch def
  gsave reg newpath x y r 0 180 arc closepath c ink grestore } forall
% water: one indigo block with carved white lines
gsave reg newpath -9 -9 630 215 cb-rect indigo cb-rgb fill grestore
0 1 16 { /i exch def /yy 190 i 12 mul sub def
  newpath 20 jit 20 add yy moveto 560 40 jit add yy 2 jit add lineto
  [0.40 0.46 0.66] cb-rgb 1.3 setlinewidth stroke } for
0 1 8 { /i exch def newpath 440 i 4 mul sub 196 i 14 mul sub moveto 60 i 6 mul add 0 rlineto ochre cb-rgb 2.4 setlinewidth stroke } for
% reeds: indigo blades over everything at the edges
[ 10 24 40 52 70 520 536 552 568 588 602 ] { /x exch def
  newpath x -9 moveto x 6 add -9 lineto x 4 jit add 4 add 190 50 jit add lineto closepath [0.12 0.16 0.24] ink } forall
[ [28 160] [62 184] [546 166] [590 150] ] { aload pop /yy exch def /xx exch def
  newpath xx 4 sub yy 16 sub 8 32 cb-rect rust ink } forall
% swans: bare paper, with an indigo key block printed slightly off
[ [300 470 70 0.9] [360 440 62 -0.4] [420 412 56 0.6] [240 440 62 0.2] [190 412 56 -0.8] ] {
  aload pop /ph exch def /s exch def /y exch def /x exch def
  /sh { newpath { x y translate s s scale ph cb-swan-wing-path } cb-local } def
  /bd { newpath { x y translate s s scale cb-swan-body-path } cb-local } def
  /w2 { newpath { x y translate s s scale ph cb-swan-wing2-path } cb-local } def
  sh cb-paper ink bd cb-paper ink w2 cb-paper ink
  gsave 1.5 -1 translate indigo cb-rgb 1.1 setlinewidth 1 setlinejoin sh stroke bd stroke w2 stroke grestore
  newpath { x y translate s s scale cb-swan-beak-path } cb-local rust ink
} forall
% the duckling: one slate block, key line in indigo
/cb-dkup true def
gsave reg newpath { 170 100 translate 80 80 scale cb-duck-body-path } cb-local slate ink grestore
gsave 1.5 -1 translate newpath { 170 100 translate 80 80 scale cb-duck-body-path } cb-local indigo cb-rgb 1.4 setlinewidth stroke grestore
newpath { 170 100 translate 80 80 scale cb-duck-beak-path } cb-local indigo ink
{ 170 100 translate 80 80 scale cb-duck-eye transform } cb-local itransform newpath 2.4 0 360 arc closepath indigo ink
% paper grain through the inks
newpath -9 -9 630 630 cb-rect grain
indigo cb-rgb
(One evening, great white birds flew over the marsh.) 60 584 492 /center cb-text pop
showpage
