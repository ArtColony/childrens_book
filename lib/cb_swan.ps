%!PS-Adobe-3.0
% cb_swan.ps -- the birds of *The Ugly Duckling*, as style-free paths.
% Each cb-*-path builds a path in a local frame where the bird is 1 unit
% long, facing left, origin at the body's middle. A style paints them:
%   { x y translate s s scale cb-swan-body-path } cb-local  <then fill/wash>
% Load after cb_kit.ps.

% ---------------------------------------------------------------- swan, flying
% The body with neck and head stretched forward (left), tail right.
/cb-swan-body-path {
  -0.66 0.07 moveto                                  % beak tip
  -0.60 0.10 -0.55 0.11 -0.50 0.10 curveto           % top of head
  -0.42 0.08 -0.34 0.05 -0.22 0.06 curveto           % back of the neck
  -0.10 0.09 0.10 0.09 0.24 0.05 curveto             % back
  0.32 0.03 0.38 0.02 0.42 0.00 curveto              % tail top
  0.38 -0.03 0.30 -0.05 0.22 -0.06 curveto           % tail under
  0.08 -0.10 -0.12 -0.08 -0.22 -0.02 curveto         % belly
  -0.34 0.02 -0.44 0.03 -0.51 0.04 curveto           % throat
  -0.56 0.04 -0.62 0.05 -0.66 0.07 curveto
  closepath
} bind def

% A broad swept wing: phase 1 = raised high, 0 = level, -1 = down.
% The far wing uses the phase as given; the near wing (wing2) is the same
% shape a little forward, in the opposite part of the beat.
/cb-swan-wingshape { % dx H -> path   (H = wing height, signed)
  2 dict begin /cb-swH exch def /cb-swdx exch def
  -0.10 cb-swdx add 0.05 moveto
  -0.13 cb-swdx add 0.05 0.30 cb-swH mul add  -0.09 cb-swdx add 0.05 0.58 cb-swH mul add  -0.03 cb-swdx add 0.05 0.66 cb-swH mul add curveto
  0.08 cb-swdx add 0.05 0.80 cb-swH mul add  0.22 cb-swdx add 0.05 0.98 cb-swH mul add  0.34 cb-swdx add 0.05 1.00 cb-swH mul add curveto
  0.27 cb-swdx add 0.05 0.70 cb-swH mul add  0.27 cb-swdx add 0.05 0.30 cb-swH mul add  0.22 cb-swdx add 0.05 curveto
  closepath
  end
} bind def
/cb-swan-wing-path { 0 exch 0.55 mul cb-swan-wingshape } bind def          % phase -> path
/cb-swan-wing2-path { -0.04 exch -0.45 mul cb-swan-wingshape } bind def    % phase -> path

% The black-and-orange beak, and the eye point.
/cb-swan-beak-path {
  -0.66 0.07 moveto -0.60 0.095 lineto -0.56 0.085 lineto -0.60 0.055 lineto closepath
} bind def
/cb-swan-eye { -0.535 0.085 } def

% ---------------------------------------------------------------- swan, swimming
% S-necked, on the water line (y = 0), facing left, 1 unit long.
/cb-swim-body-path {
  0.46 0.16 moveto                                   % raised tail
  0.40 0.10 0.30 0.02 0.18 0.00 curveto
  0.02 -0.03 -0.20 -0.03 -0.32 0.02 curveto          % the waterline
  -0.40 0.06 -0.38 0.16 -0.28 0.20 curveto           % breast
  -0.26 0.26 -0.30 0.36 -0.30 0.46 curveto           % front of the neck
  -0.30 0.56 -0.36 0.60 -0.42 0.60 curveto           % up to the head
  -0.50 0.60 -0.56 0.57 -0.58 0.54 curveto           % beak base
  -0.54 0.58 -0.46 0.64 -0.40 0.64 curveto           % crown
  -0.30 0.64 -0.24 0.56 -0.24 0.46 curveto           % back of the neck
  -0.24 0.36 -0.20 0.28 -0.10 0.24 curveto
  0.06 0.20 0.26 0.26 0.46 0.16 curveto              % folded wing to tail
  closepath
} bind def
/cb-swim-beak-path {
  -0.58 0.54 moveto -0.68 0.52 lineto -0.66 0.555 lineto -0.54 0.59 lineto closepath
} bind def
/cb-swim-eye { -0.47 0.595 } def

% ---------------------------------------------------------------- the duckling
% Grey, gangly, too-long neck; floating, facing right; 1 unit long.
% cb-dkup true lifts the head to look up (at the swans).
/cb-dkup false cb-default
/cb-duck-body-path {
  -0.46 0.14 moveto                                  % stubby tail
  -0.40 0.06 -0.30 0.00 -0.10 -0.02 curveto
  0.12 -0.03 0.30 0.00 0.36 0.08 curveto             % waterline to breast
  0.40 0.14 0.34 0.22 0.26 0.24 curveto
  cb-dkup {
    0.26 0.36 0.30 0.50 0.34 0.58 curveto            % neck stretching up
    0.36 0.66 0.44 0.70 0.50 0.68 curveto            % head top
    0.56 0.66 0.58 0.60 0.54 0.56 curveto            % face
    0.48 0.52 0.42 0.50 0.40 0.44 curveto
    0.36 0.36 0.30 0.28 0.18 0.26 curveto
  } {
    0.30 0.34 0.36 0.42 0.38 0.48 curveto            % neck forward
    0.42 0.56 0.52 0.58 0.58 0.52 curveto            % head top
    0.62 0.48 0.60 0.42 0.54 0.40 curveto
    0.46 0.38 0.40 0.36 0.36 0.32 curveto
    0.30 0.26 0.24 0.26 0.18 0.26 curveto
  } ifelse
  0.00 0.30 -0.30 0.30 -0.46 0.14 curveto            % back, ruffled
  closepath
} bind def
/cb-duck-beak-path {
  cb-dkup { 0.54 0.62 moveto 0.66 0.70 lineto 0.56 0.58 lineto closepath }
          { 0.58 0.48 moveto 0.72 0.46 lineto 0.58 0.42 lineto closepath } ifelse
} bind def
/cb-duck-eye { cb-dkup { 0.47 0.62 } { 0.51 0.49 } ifelse } def

% The same swan with its head bowed low to the water, looking down.
/cb-swim-bow-path {
  0.46 0.16 moveto
  0.40 0.10 0.30 0.02 0.18 0.00 curveto
  0.02 -0.03 -0.20 -0.03 -0.32 0.02 curveto
  -0.40 0.06 -0.38 0.16 -0.30 0.22 curveto           % breast
  -0.28 0.30 -0.30 0.40 -0.38 0.42 curveto           % the neck arches up
  -0.48 0.44 -0.56 0.36 -0.58 0.24 curveto           % and over, down to the head
  -0.60 0.16 -0.54 0.12 -0.48 0.14 curveto           % the head, low
  -0.42 0.18 -0.44 0.30 -0.40 0.34 curveto           % back up the inside of the arch
  -0.34 0.36 -0.26 0.32 -0.20 0.26 curveto
  -0.08 0.22 0.26 0.26 0.46 0.16 curveto
  closepath
} bind def
