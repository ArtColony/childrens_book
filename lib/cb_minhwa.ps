%!PS-Adobe-3.0
% cb_minhwa.ps -- Korean folk painting (minhwa) for The Golden Pig.
% Flat mineral colour inside a lively ink line: cb-wash fills, cb-line
% outlines. Every motif takes (x y size) and builds its paths with cb-local,
% so the brushes paint at page scale. All names start cb-mh-.

% ---------------------------------------------------------------- obangsaek
% The five directions' colours, and the in-between colours (gansaek), as
% watercolour can carry them: strong, but with paper showing through.
/cb-mh-blue    [0.16 0.36 0.60] def   % 청 east, spring
/cb-mh-red     [0.80 0.20 0.16] def   % 적 south, summer
/cb-mh-yellow  [0.96 0.76 0.22] def   % 황 centre
/cb-mh-white   [0.98 0.96 0.90] def   % 백 west, autumn
/cb-mh-black   [0.15 0.13 0.13] def   % 흑 north, winter
/cb-mh-green   [0.30 0.54 0.40] def   % 녹
/cb-mh-jade    [0.42 0.68 0.66] def   % 벽 (blue-green: mountains, water)
/cb-mh-pink    [0.92 0.52 0.52] def   % 홍
/cb-mh-violet  [0.48 0.30 0.50] def   % 자
/cb-mh-brown   [0.45 0.28 0.18] def
/cb-mh-gold    [0.90 0.66 0.16] def   % the golden pig: the book's accent
/cb-mh-goldhi  [1.00 0.88 0.46] def
/cb-mh-hanji   [0.95 0.91 0.81] def   % mulberry paper

% A warm hanji ground in place of cb-ground's white paper.
/cb-mh-ground {
  -9 -9 cb-W 18 add cb-H 18 add << /Tone cb-mh-hanji /Grain cb-grain >> pkpaper
} bind def

% ---------------------------------------------------------------- helpers
/cb-mh-rect { % x y w h -> (adds a closed rectangle)
  4 2 roll moveto 1 index 0 rlineto 0 exch rlineto neg 0 rlineto closepath
} bind def

% A pointed leaf or petal from (0,0) to (len,0), width wd, in the local frame.
/cb-mh-petalpath { % len wd -> (adds a closed subpath)
  2 dict begin /wd exch def /len exch def
  0 0 moveto
  len 0.30 mul wd 0.55 mul  len 0.75 mul wd 0.50 mul  len 0 curveto
  len 0.75 mul wd -0.50 mul  len 0.30 mul wd -0.55 mul  0 0 curveto
  closepath
  end
} bind def

% ---------------------------------------------------------------- sunflower
% x y r angle -> a sunflower head of radius r, turned by angle (it faces the
% viewer; the turn sets where the petals lie). Hope, in this book.
/cb-mh-sunflower {
  8 dict begin /an exch def /r exch def /y exch def /x exch def
  /n 18 def
  % back ring of petals, a little darker, offset half a step
  newpath
  0 1 n 1 sub { /i exch def
    { x y translate an i 360 mul n div add 180 n div add rotate
      r 0.42 mul 0 translate r 0.62 mul r 0.22 mul cb-mh-petalpath } cb-local
  } for
  cb-mh-gold 0.85 cb-wash
  newpath
  0 1 n 1 sub { /i exch def
    { x y translate an i 360 mul n div add rotate
      r 0.40 mul 0 translate r 0.60 mul r 0.24 mul cb-mh-petalpath } cb-local
  } for
  gsave cb-mh-yellow 0.9 cb-wash grestore
  r 70 div 0.6 max cb-line
  % the seed disk
  newpath x y r 0.44 mul 0 360 arc closepath
  gsave cb-mh-brown 0.95 cb-wash grestore
  r 60 div 0.7 max cb-line
  % seeds in a sunflower spiral (golden angle)
  cb-mh-black cb-rgb
  0 1 r 0.9 mul cvi { /i exch def
    /a i 137.508 mul def /d i sqrt r 0.44 mul 0.88 mul r 0.9 mul sqrt div mul def
    newpath x a cos d mul add y a sin d mul add r 0.022 mul 0.5 max 0 360 arc fill
  } for
  end
} bind def

% x y h lean -> a stem from (x,y) up h, bending by lean, with two leaves.
% Leaves the top point on the stack: -> tx ty
/cb-mh-stem {
  6 dict begin /ln2 exch def /h exch def /y exch def /x exch def
  newpath x y moveto x ln2 0.2 mul add y h 0.5 mul add x ln2 add y h 0.8 mul add x ln2 add y h add curveto
  gsave cb-mh-green cb-rgb h 40 div 1.2 max setlinewidth 1 setlinecap stroke grestore
  h 90 div 0.6 max cb-line
  [ [0.35 -1 40] [0.6 1 -35] ] {
    aload pop /rot exch def /side exch def /t exch def
    newpath
    { x ln2 t t mul mul add y h t mul add translate side 0 gt { 180 rot add } { rot } ifelse rotate
      h 0.32 mul h 0.13 mul cb-mh-petalpath } cb-local
    gsave cb-mh-green 0.85 cb-wash grestore h 110 div 0.5 max cb-line
  } forall
  x ln2 add y h add
  end
} bind def

% x y h lean angle -> a whole sunflower: stem, leaves and a head.
/cb-mh-sunflowerplant {
  5 dict begin /an exch def /ln2 exch def /h exch def /y exch def /x exch def
  x y h ln2 cb-mh-stem h 0.17 mul an cb-mh-sunflower
  end
} bind def

% ---------------------------------------------------------------- clouds
% x y w -> a minhwa auspicious cloud (a ruyi head with a curling tail),
% white with a blue-grey line, w wide.
/cb-mh-cloud {
  4 dict begin /w exch def /y exch def /x exch def
  /u w 10 div def
  newpath
  { x y translate u u scale
    % three round lobes over a flat base, a curl at the right, tail at left
    -3 0 moveto -3.6 1.6 -1.6 2.6 -0.6 1.6 curveto
    -0.4 3.4 2.2 3.4 2.0 1.4 curveto
    3.4 2.4 5.0 0.8 3.8 -0.4 curveto
    3.0 -1.2 1.8 -0.6 2.2 0.2 curveto
    1.4 -0.6 -1.8 -0.8 -3 0 curveto
    -4.2 -0.6 -5.0 -0.6 -6.0 -1.4 curveto
    -4.6 -0.2 -4.0 0 -3 0 curveto closepath
  } cb-local
  gsave cb-mh-white 0.95 cb-wash grestore
  gsave [0.30 0.40 0.58] cb-rgb
  << /Width w 90 div 0.7 max /Taper 0.35 /Waver 0.3 /Depletion 0.1 >> pkliner grestore
  % inner curl lines
  newpath { x y translate u u scale -1.8 1.2 moveto -1.2 1.9 -0.2 1.6 -0.4 0.9 curveto } cb-local
  [0.30 0.40 0.58] cb-rgb << /Width w 140 div 0.5 max /Taper 0.5 /Waver 0.2 >> pkliner
  newpath { x y translate u u scale 0.8 1.0 moveto 1.0 2.2 2.0 2.0 1.8 1.2 curveto } cb-local
  [0.30 0.40 0.58] cb-rgb << /Width w 140 div 0.5 max /Taper 0.5 /Waver 0.2 >> pkliner
  end
} bind def

% ---------------------------------------------------------------- mountains
% x y w h [colour] -> a minhwa peak: a tall rounded crag with jade top,
% contour bands and texture dots (the sipjangsaeng mountain).
/cb-mh-peak {
  6 dict begin /c exch def /h exch def /w exch def /y exch def /x exch def
  newpath
  { x y translate w h scale
    -0.5 0 moveto -0.48 0.45 -0.30 0.70 -0.16 0.86 curveto
    -0.06 1.02 0.10 1.02 0.18 0.84 curveto
    0.32 0.62 0.48 0.40 0.5 0 curveto closepath } cb-local
  gsave c 0.75 cb-bigwash grestore
  % lit jade cap
  gsave clip newpath
  { x y translate w h scale -0.6 0.62 moveto 0 0.78 lineto 0.6 0.58 lineto 0.6 1.2 lineto -0.6 1.2 lineto closepath } cb-local
  cb-mh-jade 0.55 cb-wash grestore
  w 120 div 0.8 max cb-line
  % contour bands, following the peak's shoulders
  [0.25 0.45 0.65] { /t exch def
    /hw 1 t sub 0.42 mul def /ty t 0.86 mul def   % half-width and height of the band
    newpath { x y translate w h scale
      hw neg ty moveto hw -0.35 mul ty 0.07 add hw 0.35 mul ty 0.07 add hw ty curveto } cb-local
    w 200 div 0.5 max cb-line
  } forall
  end
} bind def

% x y w rows -> minhwa waves: rows of scallops, each lined with a white crest.
/cb-mh-waves {
  8 dict begin /rows exch def /w exch def /y exch def /x exch def
  /s w 12 div def
  0 1 rows 1 sub { /j exch def
    /yy y j s 0.55 mul mul sub def
    /off j 2 mod s mul 0.5 mul def
    newpath x off sub yy moveto
    0 1 12 { /i exch def
      x off sub i s mul add s 0.15 mul add yy s 0.70 mul add
      x off sub i s mul add s 0.85 mul add yy s 0.70 mul add
      x off sub i 1 add s mul add yy curveto
    } for
    x off sub 13 s mul add yy s sub lineto x off sub yy s sub lineto closepath
    gsave cb-mh-blue cb-mh-jade j rows div cb-mixa 0.6 cb-wash grestore
    s 40 div 0.6 max cb-line
  } for
  end
} bind def

% ---------------------------------------------------------------- borders
% x y w h -> a dancheong band: a red ground with green and blue lozenges
% and white edges, the paint under a palace eave.
/cb-mh-dancheong {
  6 dict begin /h exch def /w exch def /y exch def /x exch def
  newpath x y w h cb-mh-rect cb-mh-red 0.85 cb-wash
  /n w h 1.2 mul div cvi 1 max def /s w n div def
  0 1 n 1 sub { /i exch def
    /cx x i 0.5 add s mul add def
    newpath cx y h 0.12 mul add moveto s 0.42 mul h 0.38 mul rlineto
      s -0.42 mul h 0.38 mul rlineto s -0.42 mul h -0.38 mul rlineto closepath
    cb-mh-green 0.9 cb-wash
    newpath cx y h 0.5 mul add h 0.18 mul 0 360 arc closepath
    gsave i 2 mod 0 eq { cb-mh-blue } { cb-mh-yellow } ifelse 0.9 cb-wash grestore
    h 60 div 0.5 max cb-line
  } for
  newpath x y moveto w 0 rlineto x y h add moveto w 0 rlineto
  gsave cb-mh-white cb-rgb h 10 div setlinewidth stroke grestore
  h 50 div 0.6 max cb-line
  end
} bind def

% x y w h cols rows -> a jogakbo panel: a patchwork of ramie squares in soft
% obangsaek, seams stitched in fine ink. The seed fixes the patchwork.
/cb-mh-jogakbo {
  10 dict begin /rows exch def /cols exch def /h exch def /w exch def /y exch def /x exch def
  /pal [ cb-mh-white cb-mh-jade cb-mh-pink cb-mh-yellow [0.86 0.88 0.80] cb-mh-white [0.70 0.80 0.86] ] def
  /cw w cols div def /rh h rows div def
  0 1 rows 1 sub { /j exch def
    0 1 cols 1 sub { /i exch def
      /sp rand 3 mod 1 add 1 min def
      newpath x i cw mul add y j rh mul add cw rh cb-mh-rect
      pal rand pal length mod get 0.45 cb-wash
    } for
  } for
  % seams
  0 1 cols { /i exch def newpath x i cw mul add y moveto 0 h rlineto 0.6 cb-line } for
  0 1 rows { /j exch def newpath x y j rh mul add moveto w 0 rlineto 0.6 cb-line } for
  end
} bind def
