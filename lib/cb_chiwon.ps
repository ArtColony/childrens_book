%!PS-Adobe-3.0
% cb_chiwon.ps -- The Golden Pig's people, as minhwa figures: flat robes,
% a round head, dot eyes, no modelled anatomy. All names start cb-ch-.
%
% Options, set just before a call:
%   cb-ch-mode   /flat (colour inside an ink line) or /silhouette (one dark
%                shape, for night pages and distant figures)
%   cb-ch-face   1 faces right, -1 faces left

/cb-ch-mode /flat cb-default
/cb-ch-face 1 cb-default
/cb-ch-skin [0.96 0.84 0.70] def
/cb-ch-silc [0.10 0.10 0.16] def

% Fill the current path in colour c, flat or as silhouette, and line it.
% c lw -> ()
/cb-ch-paint {
  cb-ch-mode /silhouette eq {
    pop pop gsave cb-ch-silc cb-rgb fill grestore newpath
  } {
    exch gsave 0.92 cb-wash grestore cb-line
  } ifelse
} bind def

% The figure's local frame: feet at (x, y), 100 units tall, facing cb-ch-face.
/cb-ch-frame { % x y h -> (in cb-local: translate and scale)
  3 dict begin /h exch def /y exch def /x exch def
  x y translate h 100 div cb-ch-face mul h 100 div scale
  end
} bind def

% x y h robe -> the magistrate, Choe Chung, walking, his front hand held out
% (to hold the thread). Silla official: a long robe, a red belt, the black
% putou hat (복두) with its stiff wings.
% Leaves the hand's page position: -> hx hy
/cb-ch-magistrate {
  6 dict begin /robe exch def /h exch def /y exch def /x exch def
  /lw h 70 div 0.6 max 1.6 min def
  /fr { x y h cb-ch-frame } def
  % shoes
  newpath { fr -9 0 moveto -9 4 -1 4 -1 0 curveto closepath
                 10 0 moveto 10 4 19 4 19 0 curveto closepath } cb-local
  cb-mh-black lw cb-ch-paint
  % the far sleeve, hanging behind
  newpath { fr -6 72 moveto -16 56 lineto -18 44 lineto -8 46 lineto -2 62 lineto closepath } cb-local
  robe [0 0 0] 0.25 cb-mixa lw cb-ch-paint
  % the robe, leaning into the climb
  newpath { fr -6 77 moveto 10 77 lineto 14 50 18 20 20 2 curveto
            8 0 -6 0 -16 3 curveto -12 24 -10 52 -6 77 curveto closepath } cb-local
  robe lw cb-ch-paint
  % hem and collar lines
  cb-ch-mode /flat eq {
    newpath { fr -14 9 moveto -2 6 10 7 18 9 curveto
              -3 77 moveto 4 66 lineto 10 76 lineto } cb-local
    lw 0.7 mul cb-line
  } if
  % belt
  newpath { fr -9 46 moveto 15 46 lineto 15 41 lineto -10 41 lineto closepath } cb-local
  cb-mh-red lw cb-ch-paint
  % the near sleeve, reaching forward
  newpath { fr 2 74 moveto 26 66 lineto 30 54 lineto 18 50 lineto 4 58 lineto closepath } cb-local
  robe lw cb-ch-paint
  % hand
  newpath { fr 33 57 3.4 0 360 arc closepath } cb-local
  cb-ch-skin lw cb-ch-paint
  % head
  newpath { fr 4 87 8.5 0 360 arc closepath } cb-local
  cb-ch-skin lw cb-ch-paint
  % putou hat: a rounded crown and one stiff wing behind
  newpath { fr -5 88 moveto -5 98 13 98 13 90 curveto 13 88 lineto closepath
            -3 92 moveto -24 93 lineto -24 90 lineto -3 89 lineto closepath } cb-local
  cb-mh-black lw cb-ch-paint
  % face: an eye, a beard
  cb-ch-mode /flat eq {
    newpath { fr 9 84.5 1.3 0 360 arc closepath } cb-local
    gsave cb-mh-black cb-rgb fill grestore newpath
    newpath { fr 8 80 moveto 10 76 9 72 11 69 curveto } cb-local
    lw 0.9 mul cb-line
    newpath { fr 6.5 87.2 moveto 11 87.4 lineto } cb-local   % brow
    lw 0.6 mul cb-line
  } if
  % the hand's page position
  x 33 h mul 100 div cb-ch-face mul add y 57 h mul 100 div add
  end
} bind def
