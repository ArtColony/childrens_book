%!PS-Adobe-3.0
% cb_chiwon.ps -- The Golden Pig's people, as minhwa figures: flat robes,
% a round head, dot eyes, no modelled anatomy. All names start cb-ch-.
%
% Options, set just before a call:
%   cb-ch-mode   /flat (colour inside an ink line) or /silhouette (one dark
%                shape, for night pages and distant figures)
%   cb-ch-face   1 faces right, -1 faces left

/cb-ch-mode /flat cb-default
/cb-ch-face 1 cb-default
/cb-ch-skin [0.96 0.84 0.70] def
/cb-ch-silc [0.10 0.10 0.16] def

% Fill the current path in colour c, flat or as silhouette, and line it.
% c lw -> ()
/cb-ch-paint {
  cb-ch-mode /silhouette eq {
    pop pop gsave cb-ch-silc cb-rgb fill grestore newpath
  } {
    exch gsave 0.92 cb-wash grestore cb-line
  } ifelse
} bind def

% The figure's local frame: feet at (x, y), 100 units tall, facing
% cb-ch-face, leaning cb-ch-lean degrees into the way they go.
/cb-ch-lean 0 cb-default
/cb-ch-frame { % x y h -> (in cb-local: translate and scale)
  3 dict begin /h exch def /y exch def /x exch def
  x y translate h 100 div cb-ch-face mul h 100 div scale cb-ch-lean neg rotate
  end
} bind def

% x y h robe -> the magistrate, Choe Chung, in three-quarter view, walking
% uphill toward cb-ch-face, his front hand out with the thread wound round
% it. A Silla official: a round-collared robe (단령), a red belt, the black
% putou hat (복두) with a two-tier crown and a stiff wing to each side.
% Leaves the hand's page position: -> hx hy
/cb-ch-magistrate {
  6 dict begin /robe exch def /h exch def /y exch def /x exch def
  /lw h 75 div 0.6 max 1.6 min def
  /fr { x y h cb-ch-frame } def
  % shoes: the back foot flat, the front foot stepping up
  newpath { fr -12 0 moveto -12 4 -2 4 -1 0 curveto closepath
                 12 5 moveto 13 10 22 10 24 6 curveto closepath } cb-local
  cb-mh-black lw cb-ch-paint
  % the far sleeve, hanging behind
  newpath { fr -6 72 moveto -15 58 lineto -17 46 lineto -7 45 lineto -1 62 lineto closepath } cb-local
  robe [0.3 0.3 0.4] 0.3 cb-mixa lw cb-ch-paint
  % the robe: the front hem lifts over the stepping leg
  newpath { fr -8 75 moveto 11 75 lineto 14 54 18 30 24 11 curveto
            12 7 -2 2 -14 3 curveto -12 26 -11 52 -8 75 curveto closepath } cb-local
  robe lw cb-ch-paint
  cb-ch-mode /flat eq {
    % the round collar and the robe's front edge
    newpath { fr -4 75 moveto -2 68 8 67 11 74 curveto
              6 67 moveto 9 48 lineto 13 30 lineto 18 12 lineto } cb-local
    lw 0.8 mul cb-line
  } if
  % belt
  newpath { fr -10 47 moveto 14 47 lineto 15 42 lineto -11 42 lineto closepath } cb-local
  cb-mh-red lw cb-ch-paint
  % the near sleeve, reaching forward, hanging wide below the arm
  newpath { fr 2 73 moveto 27 66 lineto 31 60 lineto 27 50 lineto 13 46 lineto 4 58 lineto closepath } cb-local
  robe lw cb-ch-paint
  % hand, with the red thread wound round it
  newpath { fr 34 61 3.8 0 360 arc closepath } cb-local
  cb-ch-skin lw cb-ch-paint
  newpath { fr matrix currentmatrix 34 61 translate 1 0.45 scale 0 0 4.6 0 360 arc setmatrix } cb-local
  gsave cb-mh-red cb-rgb << /Width lw 1.2 mul /Taper 0 /Waver 0.1 >> pkliner grestore
  % head
  newpath { fr 5 85 10 0 360 arc closepath } cb-local
  cb-ch-skin lw cb-ch-paint
  % putou: thin wings set high at the back of the crown, tips turned up a
  % little, then a tall two-tier crown over a band no wider than the head
  newpath { fr -3 99 moveto -24 100.5 lineto -25 103 lineto -3 101.5 lineto closepath
            12 99 moveto 30 100.5 lineto 31 103 lineto 12 101.5 lineto closepath } cb-local
  cb-mh-black lw cb-ch-paint
  newpath { fr -5 89 moveto 14 89 lineto 14 96 lineto -5 96 lineto closepath
            -3 96 moveto -3 108 12 108 12 96 curveto closepath } cb-local
  cb-mh-black lw cb-ch-paint
  cb-ch-mode /flat eq {
    % a highlight line between the two tiers of the crown
    newpath { fr -4 96.5 moveto 13 96.5 lineto } cb-local
    gsave [0.45 0.45 0.55] cb-rgb lw 0.6 mul setlinewidth stroke grestore newpath
    % the face, turned toward cb-ch-face and looking up the way
    newpath { fr 11 85.5 1.5 0 360 arc closepath } cb-local          % eye
    gsave cb-mh-black cb-rgb fill grestore newpath
    newpath { fr 8 88.5 moveto 14 89.6 lineto } cb-local              % brow, raised
    lw 0.7 mul cb-line
    newpath { fr 14.6 84 moveto 16 81.5 lineto 14.4 81 lineto } cb-local   % nose
    lw 0.6 mul cb-line
    newpath { fr 10 78 moveto 13.5 78.8 lineto } cb-local             % mouth
    lw 0.5 mul cb-line
    newpath { fr 11 76 moveto 12 72 11 68 13 64 curveto               % beard
              13 79.5 moveto 16 78 lineto 8.5 79.5 moveto 6 77.5 lineto } cb-local
    lw 0.8 mul cb-line
    newpath { fr -1.5 84 2.2 0 360 arc } cb-local                     % ear
    lw 0.6 mul cb-line
  } if
  % the hand's page position
  { fr 34 61 transform } cb-local itransform   % device point, back in page space
  end
} bind def
